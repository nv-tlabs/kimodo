@@ -0,0 +1,141 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026
+# SPDX-License-Identifier: Apache-2.0
+"""Small, dependency-light BVH exporter for ARDY motion outputs."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+
+def _children_from_parents(parents: Sequence[int]) -> list[list[int]]:
+    children = [[] for _ in parents]
+    roots = []
+    for joint, parent in enumerate(parents):
+        if parent < 0:
+            roots.append(joint)
+        else:
+            children[parent].append(joint)
+    if len(roots) != 1:
+        raise ValueError(f"BVH requires exactly one root joint; found {len(roots)}")
+    return children
+
+
+def _joint_offsets(rest_positions: np.ndarray, parents: Sequence[int]) -> np.ndarray:
+    offsets = np.asarray(rest_positions, dtype=np.float64).copy()
+    for joint, parent in enumerate(parents):
+        if parent < 0:
+            offsets[joint] = 0.0
+        else:
+            offsets[joint] -= rest_positions[parent]
+    return offsets
+
+
+def _leaf_offset(joint: int, offsets: np.ndarray, parents: Sequence[int]) -> np.ndarray:
+    direction = offsets[joint]
+    if np.linalg.norm(direction) < 1e-8:
+        parent = parents[joint]
+        direction = offsets[parent] if parent >= 0 else np.array([0.0, 0.05, 0.0])
+    norm = np.linalg.norm(direction)
+    if norm < 1e-8:
+        return np.array([0.0, 0.05, 0.0])
+    return direction / norm * 0.05
+
+
+def _fmt_vec(values: np.ndarray) -> str:
+    return " ".join(f"{float(value):.7f}" for value in values)
+
+
+def write_bvh(
+    path: str | Path,
+    *,
+    joint_names: Sequence[str],
+    parents: Sequence[int],
+    rest_positions: np.ndarray,
+    local_rot_mats: np.ndarray,
+    root_positions: np.ndarray,
+    fps: float,
+) -> Path:
+    """Write local joint rotations and root translation to a Blender-readable BVH.
+
+    ARDY uses a Y-up metric coordinate system. The exported BVH preserves those
+    units and uses Z-X-Y Euler channels, which Blender's BVH importer supports.
+    """
+    path = Path(path)
+    names = [str(name).replace(" ", "_") for name in joint_names]
+    parents = [int(parent) for parent in parents]
+    rotations = np.asarray(local_rot_mats, dtype=np.float64)
+    roots = np.asarray(root_positions, dtype=np.float64)
+    rest = np.asarray(rest_positions, dtype=np.float64)
+
+    joint_count = len(names)
+    if rotations.ndim != 4 or rotations.shape[1:] != (joint_count, 3, 3):
+        raise ValueError(
+            "local_rot_mats must have shape [frames, joints, 3, 3]; "
+            f"received {rotations.shape}"
+        )
+    if roots.shape != (rotations.shape[0], 3):
+        raise ValueError(f"root_positions must have shape [frames, 3]; received {roots.shape}")
+    if rest.shape != (joint_count, 3):
+        raise ValueError(f"rest_positions must have shape [joints, 3]; received {rest.shape}")
+    if fps <= 0:
+        raise ValueError("fps must be greater than zero")
+
+    children = _children_from_parents(parents)
+    root = parents.index(-1)
+    offsets = _joint_offsets(rest, parents)
+    channel_order: list[int] = []
+    lines = ["HIERARCHY"]
+
+    def add_joint(joint: int, depth: int, is_root: bool = False) -> None:
+        indent = "  " * depth
+        label = "ROOT" if is_root else "JOINT"
+        lines.append(f"{indent}{label} {names[joint]}")
+        lines.append(f"{indent}{{")
+        lines.append(f"{indent}  OFFSET {_fmt_vec(offsets[joint])}")
+        if is_root:
+            lines.append(
+                f"{indent}  CHANNELS 6 Xposition Yposition Zposition "
+                "Zrotation Xrotation Yrotation"
+            )
+        else:
+            lines.append(f"{indent}  CHANNELS 3 Zrotation Xrotation Yrotation")
+        channel_order.append(joint)
+        for child in children[joint]:
+            add_joint(child, depth + 1)
+        if not children[joint]:
+            lines.append(f"{indent}  End Site")
+            lines.append(f"{indent}  {{")
+            lines.append(f"{indent}    OFFSET {_fmt_vec(_leaf_offset(joint, offsets, parents))}")
+            lines.append(f"{indent}  }}")
+        lines.append(f"{indent}}}")
+
+    add_joint(root, 0, is_root=True)
+    lines.extend(
+        [
+            "MOTION",
+            f"Frames: {rotations.shape[0]}",
+            f"Frame Time: {1.0 / float(fps):.9f}",
+        ]
+    )
+
+    # scipy uses intrinsic rotations for uppercase sequences, matching BVH's
+    # channel interpretation.
+    eulers = Rotation.from_matrix(rotations.reshape(-1, 3, 3)).as_euler(
+        "ZXY", degrees=True
+    )
+    eulers = eulers.reshape(rotations.shape[0], joint_count, 3)
+    for frame in range(rotations.shape[0]):
+        values: list[float] = []
+        for index, joint in enumerate(channel_order):
+            if index == 0:
+                values.extend(roots[frame].tolist())
+            values.extend(eulers[frame, joint].tolist())
+        lines.append(" ".join(f"{value:.7f}" for value in values))
+
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return path
